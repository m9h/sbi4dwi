# SBI_dMRI (Nottingham, Manzano-Patron et al. MedIA 2025) on the DGX Spark.
# Base: most recent NGC PyTorch available locally (2026-09-14: 26.06).
ARG BASE=nvcr.io/nvidia/pytorch:26.06-py3
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "sbi>=0.23" nibabel h5py joblib tqdm pandas
# their code (cloned at /home/mhough/dev/dmipy/sbi_dmri_temp; requirements pin sbi 0.22 / torch 2.2,
# we run the modules directly with the container's torch and the current sbi API)
COPY sbi_dmri_temp /workspace/sbi_dmri
COPY docker/sbi_dmri_run.py /workspace/sbi_dmri_run.py
WORKDIR /workspace/sbi_dmri
ENV PYTHONPATH=/workspace/sbi_dmri
ENTRYPOINT ["python", "/workspace/sbi_dmri_run.py"]
